# ─── LLM (extraction, Q&A, summaries) ─────────────────────────
# none              -> no AI: documents are stored/searchable, extraction shows "unavailable"
# groq              -> FREE tier, no card. Key: https://console.groq.com/keys
#                      Groq's Services Agreement forbids training on your inputs/outputs.
# openai_compatible -> any OpenAI-style server, e.g. local Ollama (contract text never leaves your PC)
# anthropic         -> paid, optional
LLM_PROVIDER=none
# Empty = provider default (groq: openai/gpt-oss-120b, anthropic: claude-sonnet-5).
# Required for openai_compatible (e.g. qwen2.5:14b).
LLM_MODEL=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# openai_compatible only:
LLM_BASE_URL=
OPENAI_API_KEY=
# Pacing for Groq's free tier (30 req/min, 8K tokens/min, 200K tokens/day). Raise on paid plans.
LLM_RPM_LIMIT=25
LLM_TPM_LIMIT=6500

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://contractlens:contractlens@localhost:5432/contractlens

# ─── Storage / uploads ────────────────────────────────────────
STORAGE_PATH=./storage
MAX_UPLOAD_MB=20

# ─── Auth ─────────────────────────────────────────────────────
# demo  = one shared unauthenticated user (local trial only; refused when APP_ENV=production)
# login = email + password accounts, each user sees only their own contracts
AUTH_MODE=demo
ALLOW_REGISTRATION=true
COOKIE_SECURE=false
DEMO_USER_EMAIL=demo@contractlens.ai
DEMO_USER_NAME=Demo User

# ─── Alerts ───────────────────────────────────────────────────
ALERT_LEAD_DAYS=30,14,7

# ─── App ──────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
APP_ENV=development
LOG_LEVEL=info
